# Für den ersten Start ist keine .env nötig. Diese Werte sind lokale Entwicklungswerte.
WEB_PORT=5173
API_PORT=3001
DB_PORT=5432
POSTGRES_PASSWORD=happiness_local
# false: offene Lernaufgaben antworten mit 501 statt auf Referenzdaten zurückzugreifen.
ENABLE_EXERCISE_FIXTURES=true
# Für lokale Node-Prozesse außerhalb von Docker:
DATABASE_URL=postgresql://happiness:happiness_local@localhost:5432/happiness
