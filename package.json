{
  "name": "happiness-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "World Happiness – vollständiges Frontend und Backend-Lernprojekt",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @happiness/web",
    "dev:api": "npm run dev -w @happiness/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run typecheck && npm run build -w @happiness/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:acceptance": "node --import tsx scripts/acceptance.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:watch": "nodemon -L --watch db/migrations --ext sql --delay 1 --exec 'npm run db:migrate'",
    "data:prepare": "python3 scripts/prepare_data.py",
    "data:download": "python3 scripts/prepare_data.py --download"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
